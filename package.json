{
  "name": "codmium-ecommerce-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3060",
    "build": "next build",
    "start": "next start -p 3060",
    "lint": "next lint",
    "migrate": "npx drizzle-kit generate --config drizzle.config.ts",
    "apply:migrations": "drizzle-kit migrate --config=drizzle.config.ts",
    "drop:migrations": "npx drizzle-kit drop --config drizzle.config.ts",
    "seed": "tsx db/seed.ts",
    "db:backup": "dotenv -e .env -- sh -c 'pg_dump -h \"$DB_HOST\" -p \"$DB_PORT\" -U \"$DB_USER\" -d \"$DB_NAME\" -F c -b -v -f backup.dump'",
    "db:restore": "dotenv -e .env -- sh -c 'pg_restore -h \"$DB_HOST\" -p \"$DB_PORT\" -U \"$DB_USER\" -d \"$DB_NAME\" -v backup.dump'",
    "db:fix:schema": "pnpm run db:backup && pnpm run drop:db && DEBUG=1 pnpm run migrate && pnpm run apply:migrations && pnpm run db:restore && pnpm run seed",
    "clear:db": "tsx db/clear.ts",
    "drop:db": "tsx db/drop.ts",
    "prepare:db": "DEBUG=1 pnpm run migrate && pnpm run apply:migrations && pnpm run seed",
    "deploy": "pnpm i --legacy-peer-deps && pnpm run prepare:db && pnpm run build && pm2 restart codmium-ecommerce",
    "deploy:standalone": "pnpm install --prod && pnpm run apply:migrations && pnpm run seed"
  },
  "dependencies": {
